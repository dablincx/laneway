# laneway example env file, generated by `laneway config docs`, don't edit by hand.
# Full reference: docs/configuration/environment-variables.md
# Required vars are uncommented. Everything else shows its default.

# --- General ---

# Public base URL of the instance, used for links, emails and OAuth.
# type: URL
LANEWAY_PUBLIC_URL=https://laneway.example.com

# Master key for sessions and for encrypting secrets at rest. Generate one with `openssl rand -hex 32`. Changing it logs everyone out and makes stored secrets unreadable.
# type: string, at least 32 characters, secret (or LANEWAY_SECRET_KEY_FILE), env var only
LANEWAY_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Which part of laneway this container runs: the web app + API, the background worker, or both in one process (fine for small installs).
# type: one of app, worker, all, env var only
#LANEWAY_PROCESS_ROLE=all

# Language for new users and logged-out pages.
# type: locale code (e.g. en, de, pt-BR)
#LANEWAY_DEFAULT_LOCALE=en

# Creates the first admin on start with this email (and `LANEWAY_INITIAL_ADMIN_PASSWORD`), so the setup page is skipped. Only used while no admin exists. The username is taken from the part before the @.
# type: string, env var only
#LANEWAY_INITIAL_ADMIN_EMAIL=admin@example.com

# Password for the admin created from `LANEWAY_INITIAL_ADMIN_EMAIL`. Remove both vars once the admin exists, changing them later has no effect.
# type: string, at least 10 characters, secret (or LANEWAY_INITIAL_ADMIN_PASSWORD_FILE), env var only
#LANEWAY_INITIAL_ADMIN_PASSWORD=a-long-password-only-used-once

# --- Database ---

# Postgres 18 connection URL. Older Postgres versions are refused at startup.
# type: Postgres URL, secret (or LANEWAY_DATABASE_URL_FILE), env var only
LANEWAY_DATABASE_URL=postgres://laneway:password@postgres:5432/laneway

# Max open database connections per laneway process.
# type: integer (1-1000), env var only
#LANEWAY_DATABASE_MAX_CONNECTIONS_COUNT=10

# --- HTTP ---

# Port the app listens on inside the container.
# type: integer (1-65535), env var only
#LANEWAY_HTTP_PORT=3000

# Trust `X-Forwarded-For` / `X-Forwarded-Proto` headers. Only turn this on behind a reverse proxy that sets them, otherwise clients can fake their IP.
# type: boolean (true or false)
#LANEWAY_TRUST_PROXY_HEADERS=false

# --- Storage ---

# Where board git repos and attachments are stored. Mount a volume here.
# type: path, env var only
#LANEWAY_DATA_DIRECTORY=/data

# --- Worker ---

# How many background jobs one worker process runs at the same time.
# type: integer (1-256)
#LANEWAY_WORKER_CONCURRENCY_COUNT=4

# --- Logging ---

# Log verbosity.
# type: one of debug, info, warn, error, env var only
#LANEWAY_LOG_LEVEL=info

# How many days of log files to keep in `<data directory>/logs`. Logs rotate daily, older files are deleted.
# type: integer (1-3650), env var only
#LANEWAY_LOG_RETENTION_DAYS=14
