{
  "openapi": "3.1.0",
  "info": {
    "title": "laneway API",
    "description": "REST API of laneway. The web UI uses exactly this API.",
    "contact": {
      "name": "laneway contributors"
    },
    "license": {
      "name": "GPL-3.0-or-later",
      "identifier": "GPL-3.0-or-later"
    },
    "version": "0.1.5"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logs in with email or username + password. Sets the session cookie.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "wrong login or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "too many failed attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Ends the current session and clears the cookie.",
        "operationId": "logout",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/v1/boards": {
      "get": {
        "tags": [
          "boards"
        ],
        "summary": "Boards you can see.",
        "operationId": "list_boards",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Board"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "boards"
        ],
        "summary": "Creates a board in your personal workspace.",
        "operationId": "create_board",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBoardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardDetail"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/boards/{board_id}": {
      "get": {
        "tags": [
          "boards"
        ],
        "summary": "A board with its columns and cards.",
        "operationId": "get_board",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "boards"
        ],
        "summary": "Changes a board. Fields left out stay as they are.",
        "operationId": "update_board",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBoardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Board"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/boards/{board_id}/columns": {
      "post": {
        "tags": [
          "boards"
        ],
        "summary": "Adds a column at the right end of the board.",
        "operationId": "create_column",
        "parameters": [
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateColumnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Column"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/boards/{board_id}/history": {
      "get": {
        "tags": [
          "boards"
        ],
        "summary": "Recent changes on a board, newest first.",
        "operationId": "board_history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "How many entries, newest first (1-500, default 50).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          },
          {
            "name": "board_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryEntry"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cards/{card_id}": {
      "delete": {
        "tags": [
          "boards"
        ],
        "summary": "Deletes a card.",
        "operationId": "delete_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "boards"
        ],
        "summary": "Changes a card. Fields left out stay as they are.",
        "operationId": "update_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cards/{card_id}/move": {
      "post": {
        "tags": [
          "boards"
        ],
        "summary": "Moves a card within or between columns.",
        "operationId": "move_card",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveCardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/columns/{column_id}": {
      "delete": {
        "tags": [
          "boards"
        ],
        "summary": "Deletes an empty column.",
        "operationId": "delete_column",
        "parameters": [
          {
            "name": "column_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "the column still has cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "boards"
        ],
        "summary": "Changes a column. Fields left out stay as they are.",
        "operationId": "update_column",
        "parameters": [
          {
            "name": "column_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateColumnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Column"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/columns/{column_id}/cards": {
      "post": {
        "tags": [
          "boards"
        ],
        "summary": "Adds a card at the bottom of a column.",
        "operationId": "create_card",
        "parameters": [
          {
            "name": "column_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/columns/{column_id}/move": {
      "post": {
        "tags": [
          "boards"
        ],
        "summary": "Moves a column.",
        "operationId": "move_column",
        "parameters": [
          {
            "name": "column_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveColumnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Column"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instance": {
      "get": {
        "tags": [
          "instance"
        ],
        "summary": "What this server is. Clients call this first.",
        "operationId": "instance",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instance"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The logged-in user.",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Creates the first admin with the setup token from the logs, and logs them in.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "403": {
            "description": "wrong setup token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "setup already done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Board": {
        "type": "object",
        "required": [
          "id",
          "workspace_id",
          "owner_id",
          "name",
          "description",
          "agent_access_enabled",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "agent_access_enabled": {
            "type": "boolean",
            "description": "Agents (MCP) can see and use this board."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "BoardDetail": {
        "type": "object",
        "description": "A board with its columns and cards, both in display order.",
        "required": [
          "board",
          "columns",
          "cards"
        ],
        "properties": {
          "board": {
            "$ref": "#/components/schemas/Board"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Column"
            }
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "board_id",
          "column_id",
          "position",
          "title",
          "description",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "board_id": {
            "type": "string",
            "format": "uuid"
          },
          "column_id": {
            "type": "string",
            "format": "uuid"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "description": "Markdown."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "type": "string",
            "description": "Sort key within the column. Cards are returned in order."
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Column": {
        "type": "object",
        "required": [
          "id",
          "board_id",
          "name",
          "position",
          "is_done"
        ],
        "properties": {
          "board_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_done": {
            "type": "boolean",
            "description": "Cards in a done column count as completed."
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "description": "Sort key. Columns are returned in order; clients don't need to compare these."
          },
          "wip_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "CreateBoardRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "agent_access_enabled": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Defaults to true."
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewColumnRequest"
            },
            "description": "Starting columns, left to right. The web UI sends translated defaults."
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateCardRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreateColumnRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "is_done": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "wip_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. `invalid_credentials`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation (English for now)."
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "required": [
          "id",
          "actor_type",
          "type",
          "payload",
          "created_at"
        ],
        "properties": {
          "actor_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actor_type": {
            "type": "string",
            "description": "`user`, `agent`, `api_key`, `system` or `sync`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {},
          "type": {
            "type": "string",
            "description": "e.g. `card.move`."
          }
        }
      },
      "Instance": {
        "type": "object",
        "required": [
          "name",
          "version",
          "needs_setup"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "needs_setup": {
            "type": "boolean",
            "description": "`true` until the first admin exists: show the setup page."
          },
          "version": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string",
            "description": "Email or username."
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The logged-in user.",
        "required": [
          "id",
          "email",
          "username",
          "name",
          "instance_role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "instance_role": {
            "type": "string",
            "description": "`admin` or `user`."
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
